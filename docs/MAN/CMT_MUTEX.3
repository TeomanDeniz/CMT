.PP
   *   *   *   *   *
.SS \f[CR]MUTEX_CREATE\f[R]
.IP
.EX
int MUTEX_CREATE(T_MUTEX *);
int mutex_create(t_mutex *);
.EE
.PP
Initializes a mutex object.
.PP
The argument is a pointer to a mutex handle that will be initialized by
the function.
.PP
Returns \f[CR]0\f[R] on success, or a non\-zero value on failure.
.PP
\f[B]Example\f[R]:
.IP
.EX
t_mutex mutex;

mutex_create(&mutex);

\f[B]if\f[R] (!mutex)
{
    \f[I]// handle error\f[R]
}
.EE
.PP
   *   *   *   *   *
.SS \f[CR]MUTEX_DESTROY\f[R]
.IP
.EX
int MUTEX_DESTROY(T_MUTEX *);
int mutex_destroy(t_mutex *);
.EE
.PP
Destroys a mutex created with \f[CR]mutex_create\f[R].
.PP
The mutex becomes invalid after this call.
.PP
Returns \f[CR]0\f[R] on success, or a non\-zero value on failure.
.PP
\f[B]Example\f[R]:
.IP
.EX
mutex_destroy(&mutex);
.EE
.PP
   *   *   *   *   *
.SS \f[CR]MUTEX_LOCK\f[R]
.IP
.EX
#define MUTEX_LOCK(MUTEX)
#define mutex_lock(MUTEX)
.EE
.PP
Blocks until the mutex is acquired.
.PP
\f[B]Example\f[R]:
.IP
.EX
mutex_lock(mutex);
.EE
.PP
   *   *   *   *   *
.SS \f[CR]MUTEX_UNLOCK\f[R]
.IP
.EX
#define MUTEX_UNLOCK(MUTEX)
#define mutex_unlock(MUTEX)
.EE
.PP
Releases a previously acquired mutex.
.PP
\f[B]Example\f[R]:
.IP
.EX
mutex_unlock(mutex);
.EE
