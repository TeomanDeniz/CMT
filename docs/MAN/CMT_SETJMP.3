.PP
Buffer
.PP
   *   *   *   *   *
.SS \f[CR]JMP_BUF\f[R]
.IP
.EX
#define jmp_buf
#define JMP_BUF
.EE
.PP
Defines the jump\-buffer type used by \f[CR]SETJMP\f[R] and
\f[CR]LONGJMP\f[R].
.PP
   *   *   *   *   *
.SS \f[CR]SETJMP\f[R]
.IP
.EX
#define setjmp(env)
#define SETJMP(ENV)
.EE
.PP
Saves the current execution environment into \f[CR]ENV\f[R].
.PP
Returns \f[CR]0\f[R] when the environment is saved normally.
.PP
When execution later returns through \f[CR]LONGJMP\f[R],
\f[CR]SETJMP\f[R] returns the value supplied to \f[CR]LONGJMP\f[R].
.PP
\f[B]Example\f[R]:
.IP
.EX
JMP_BUF ENV;

\f[B]if\f[R] (SETJMP(ENV) == 0)
{
    \f[I]/* normal execution */\f[R]
}
\f[B]else\f[R]
{
    \f[I]/* returned through LONGJMP */\f[R]
}
.EE
.PP
   *   *   *   *   *
.SS \f[CR]LONGJMP\f[R]
.IP
.EX
#define longjmp(env, val)
#define LONGJMP(ENV, VAL)
.EE
.PP
Restores the execution environment previously saved by
\f[CR]SETJMP\f[R].
.PP
Execution continues at the corresponding \f[CR]SETJMP\f[R] call.
.PP
\f[CR]VAL\f[R] becomes the return value of \f[CR]SETJMP\f[R].
.PP
\f[B]Example\f[R]:
.IP
.EX
JMP_BUF ENV;

\f[B]if\f[R] (SETJMP(ENV) == 0)
{
    LONGJMP(ENV, 1);
}
\f[B]else\f[R]
{
    \f[I]/* execution resumes here */\f[R]
}
.EE
