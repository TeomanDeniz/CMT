.PP
   *   *   *   *   *
.SS TRY
.IP
.EX
#define TRY
#define try
.EE
.PP
Begins a protected execution block.
.PP
If no exception is thrown, execution continues normally through the
block.
Exceptions raised with \f[CR]THROW\f[R] immediately transfer execution
to the matching \f[CR]CATCH\f[R] block.
.SS Example
.IP
.EX
TRY
{
    printf(\(dqBefore exception.\(rsn\(dq);
    THROW(\(dqSomething went wrong.\(dq);
    printf(\(dqThis line is never reached.\(rsn\(dq);
}
CATCH(var error)
{
    printf(\(dq%s\(rsn\(dq, error);
}
.EE
.PP
   *   *   *   *   *
.SS CATCH
.IP
.EX
#define CATCH(ERROR_VARIABLE)
#define catch(error_variable)
.EE
.PP
Handles an exception raised by a matching \f[CR]TRY\f[R] block.
.PP
The specified variable receives the value supplied to \f[CR]THROW\f[R].
If no exception was thrown, the \f[CR]CATCH\f[R] block is skipped.
.SS Example
.IP
.EX
PTR error;

TRY
{
    THROW(\(dqFile not found.\(dq);
}
CATCH(error)
{
    printf(\(dqError: %s\(rsn\(dq, (char *)error);
}
.EE
.PP
   *   *   *   *   *
.SS THROW
.IP
.EX
static int  THROW(VAR);
static int  throw(var);
.EE
.PP
Raises an exception from within an active \f[CR]TRY\f[R] block.
.PP
Execution immediately leaves the current protected block and resumes in
its matching \f[CR]CATCH\f[R] block, passing the supplied value as the
exception.
.PP
If no \f[CR]TRY\f[R] block is currently active, the macro has no effect.
.SS Example
.IP
.EX
\f[B]if\f[R] (file == NULL)
{
    \f[B]throw\f[R](\(dqUnable to open file.\(dq);
}
.EE
.PP
   *   *   *   *   *
.SS IS_IN_TRY
.IP
.EX
#define IS_IN_TRY
#define is_in_try
.EE
.PP
Evaluates to a non\-zero value when execution is currently inside one or
more active \f[CR]TRY\f[R] blocks.
.PP
This can be used to determine whether calling \f[CR]THROW\f[R] would
transfer control to an exception handler.
.SS Example
.IP
.EX
\f[B]if\f[R] (IS_IN_TRY)
{
    THROW(\(dqUnexpected error.\(dq);
}
.EE
.PP
   *   *   *   *   *
.SS Examples
.SS Basic Try/Catch
.IP
.EX
\f[B]try\f[R]
{
    \f[B]if\f[R] (1)
        \f[B]throw\f[R] (99);
}
\f[B]catch\f[R] (var err)
{
    printf(\(dqERROR: %d\(rsn\(dq, err);
}
.EE
.PP
   *   *   *   *   *
.SS TCC (Tiny C Compiler) Compatibility
Compilers like TCC do not allow variable declarations inside control
clauses (e.g.
\f[CR]for (int a;...)\f[R]).
.PP
So, declare \f[CR]var err;\f[R] outside the \f[CR]catch()\f[R] scope:
.IP
.EX
var err;

\f[B]try\f[R]
{
    \f[B]if\f[R] (1)
        \f[B]throw\f[R] (99);
}
\f[B]catch\f[R] (err)
{
    printf(\(dqERROR: %d\(rsn\(dq, err);
}
.EE
.PP
   *   *   *   *   *
.SS Try/Catch Inside a Called Function
.IP
.EX
#include \f[B]<stdio.h>\f[R]
#include \f[B]\(dqCMT/KEYWORDS/TRY_CATCH.H\(dq\f[R]

int test(void)
{
    \f[B]if\f[R] (is_in_try)
        \f[B]throw\f[R] (\(dqtest runned in TRY block\(dq);
    \f[B]else\f[R]
        \f[B]return\f[R] (\-1);

    \f[B]return\f[R] (0);
}

int main(void)
{
    \f[B]try\f[R]
    {
        test();
    }
    \f[B]catch\f[R] (char *err)
    {
        printf(\(dqERROR: %s\(rsn\(dq, err);
    }

    \f[B]return\f[R] (0);
}
.EE
.PP
   *   *   *   *   *
.SS Nested Try/Catch
.IP
.EX
\f[B]try\f[R]
{
    \f[B]try\f[R] {
        \f[B]throw\f[R] (42);
    }
    \f[B]catch\f[R] (var error) {
        printf(\(dqerr_1: %d\(rsn\(dq, error);
        \f[B]throw\f[R] (32);
    }
}
\f[B]catch\f[R] (var error)
{
    printf(\(dqerr_2: %d\(rsn\(dq, error);
}
.EE
