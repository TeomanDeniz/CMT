.TE
.PP
   *   *   *   *   *
.SS MAX_ALIGNMENT
.IP
.EX
#define MAX_ALIGNMENT
.EE
.PP
Returns the size of maximum required alignment supported but compiler or
operating system.
.PP
   *   *   *   *   *
.SS ALIGN_UP
.IP
.EX
#define ALIGN_UP(VALUE)
#define align_up(value)
.EE
.PP
Rounds \f[CR]VALUE\f[R] up to the nearest multiple of
\f[CR]MAX_ALIGNMENT\f[R] to ensure proper memory alignment.
.PP
This ensures that \f[CR]offset\f[R] is aligned according to the largest
type in \f[CR]MAX_ALIGNMENT\f[R].
.PP
Example:
.IP
.EX
size_t  offset = ALIGN_UP(current_offset);
.EE
.PP
   *   *   *   *   *
.SS ALIGN_VARIABLE
.IP
.EX
#define ALIGN_VARIABLE(VALUE)
#define align_variable(value)
.EE
.PP
Rounds a \f[CR]VALUE\f[R] up to the next multiple of the maximum
required alignment for a variable.
.PP
\f[B]Examples\f[R]:
.IP
.EX
ALIGN_VARIABLE(16) int var;
align_variable(16) int var = 42;
.EE
.PP
   *   *   *   *   *
.SS ALIGN_STRUCT_PUSH, ALIGN_STRUCT_POP
.IP
.EX
#define ALIGN_STRUCT_PUSH(VALUE)
#define align_struct_push(value)

#define ALIGN_STRUCT_POP(VALUE)
#define align_struct_pop(value)
.EE
.PP
Rounds a \f[CR]VALUE\f[R] up to the next multiple of the maximum
required alignment for the start of struct.
.PP
\f[B]Examples\f[R]:
.IP
.EX
ALIGN_STRUCT_PUSH(MAX_ALIGNMENT)
\f[B]struct\f[R] s_struct
{
    . . .
} ALIGN_STRUCT_POP(MAX_ALIGNMENT);

align_struct_push(MAX_ALIGNMENT)
\f[B]typedef\f[R] \f[B]struct\f[R] s_struct
{
    . . .
} align_struct_pop(MAX_ALIGNMENT) t_struct;
.EE
