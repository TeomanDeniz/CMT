.IP
.EX
asm(\(dqint $3\(dq);
asm volatile (
    \(dqmov %1, %0\(rsn\(rst\(dq \f[I]/* COMMENT LINE */\f[R]
    \(dqadd $1, %0\(dq
    : \(dq=r\(dq (dst) 
    : \(dqr\(dq (src)
);
.EE
