.PP
   *   *   *   *   *
.SS IS__INLINE_ASM__SUPPORTED
Defined if the compiler supports inline assembly.
.PP
   *   *   *   *   *
.SS ACC (ARM C Compiler) \- \f[CR]INLINE_ASM_TYPE__MSVC\f[R]
.IP
.EX
int VARIABLE_1;
int VARIABLE_2;
    
__asm
{
    MRS VARIABLE_1, CPSR \f[I]/* COMMENT LINE */\f[R]
    ORR VARIABLE_1, VARIABLE_1, #0x80
    BIC VARIABLE_1, VARIABLE_1, VARIABLE_2, LSL #7
    MSR CPSR_c, VARIABLE_1
}
.EE
.PP
   *   *   *   *   *
.SS Aztec C Compiler \- \f[CR]INLINE_ASM_TYPE__AZTEC\f[R]
.IP
.EX
#\f[B]asm\f[R]
* COMMENT LINE

LOAD equ $ffd5
    lda #0
    ldx #0
    ldy #$18
    jsr LOAD
    rts
#\f[B]endasm\f[R]
.EE
.PP
   *   *   *   *   *
.SS Borland C Compiler \- \f[CR]INLINE_ASM_TYPE__BORLAND\f[R]
.IP
.EX

asm mov ax, ds; \f[I]/* COMMENT LINE */\f[R]
asm {
    pop ax;
    pop ds;
    iret;
}
asm {
    pop ax \f[I]/* COMMENT LINE */\f[R]
    pop ds
    iret
}
asm push ds
.EE
.PP
   *   *   *   *   *
.SS CC65 \- \f[CR]INLINE_ASM_TYPE__CC65\f[R]
.IP
.EX
int foo;
int bar () { \f[B]return\f[R] 1; }

asm (\(dqlda %v\(dq, foo);
__asm__ (\(dqjsr %v\(dq, bar);
__asm__ (
    \(dqlda #0\(rsn\(dq \f[I]/* COMMENT LINE */\f[R]
    \(dqsta $0200\(rsn\(dq
    \(dqinx\(rsn\(dq
    \(dqdex\(rsn\(dq
    \(dqjmp $F000\(rsn\(dq
);
.EE
.PP
   *   *   *   *   *
.SS Clang \- \f[CR]INLINE_ASM_TYPE__GNU\f[R]
.IP
.EX
asm volatile (
    \(dqmovl   %%eax, %%ebx\(rsn\(dq \f[I]/* COMMENT LINE */\f[R]
    \(dqaddl   %%ebx, %%esi\(dq :::
);
asm volatile (
    \(dqmovl   %%eax, %%ebx\(rsn\(dq 
    \(dqaddl   %%ebx, %0\(dq 
     : 
    \(dq=r\(dq(out_var)
    ::
);
.EE
.PP
   *   *   *   *   *
.SS Digital Mars Compiler \- \f[CR]INLINE_ASM_TYPE__DIGITAL_MARS\f[R]
.IP
.EX
short VARIABLE;

asm mov AX, VARIABLE

asm mov AH,2
asm mov DL,7
asm int 21\f[B]H\f[R]
asm
{
    mov AH,2 \f[I]/* COMMENT LINE */\f[R]
    mov DL,7
    int 21\f[B]H\f[R]
}
.EE
.PP
