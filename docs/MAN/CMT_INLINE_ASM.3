.EE
.PP
   *   *   *   *   *
.SS Microsoft C Compiler \- \f[CR]INLINE_ASM_TYPE__MSVC\f[R]
.IP
.EX
__asm
{
    push ebp \f[I]/* COMMENT LINE */\f[R]
    mov  ebp, esp
    sub  esp, __LOCAL_SIZE
}

__asm push ebp
__asm mov  ebp, esp
__asm sub  esp, __LOCAL_SIZE
.EE
.PP
