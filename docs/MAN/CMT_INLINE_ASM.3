.SS Oracle Solaris Studio \- \f[CR]INLINE_ASM_TYPE__SOLARIS\f[R]
.IP
.EX
__asm(\(dq\(rsn\(rs
    movl  8(%ebp), %ecx / COMMENT LINE \(rsn\(rs
    addl  12(%ebp), %ecx \(rsn\(rs
    addl  16(%ebp), %ecx \(rsn\(rs
    movl  %ecx, (%esp) \(rsn\(rs
    movl  %ecx, %eax \(rsn\(rs
\(dq);
.EE
.PP
