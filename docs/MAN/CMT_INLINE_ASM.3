asm( \(dqpushl %eax\(rsn\(rst\(dq \(dqmovl $0, %eax\(rsn\(rst\(dq \(dqpopl %eax\(dq);
asm(
    \(dqmovl %1, %%eax\(rsn\(dq \f[I]/* COMMENT LINE */\f[R]
