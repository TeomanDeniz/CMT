.SS Pelles C \- \f[CR]INLINE_ASM_TYPE__MSVC\f[R]
.IP
.EX
__asm mov eax, 0

__asm {
    push eax \f[I]/* COMMENT LINE */\f[R]
    mov  eax, 1
    add  eax, 2
    pop  eax
}
.EE
.PP
