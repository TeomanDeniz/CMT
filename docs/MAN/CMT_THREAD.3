.SS THREAD_CREATE
.IP
.EX
T_THREAD    THREAD_CREATE(void *(*) (void *), void *);
t_thread    thread_create(void *(*) (void *), void *);
.EE
.PP
Creates a new thread and starts execution immediately.
.PP
The first argument is the thread entry function, which must have
signature \f[CR]void *(*)(void *)\f[R].
.PP
The second argument is passed as the input parameter to the thread
function.
.PP
Returns a thread handle (\f[CR]t_thread\f[R] / \f[CR]T_THREAD\f[R]) on
success, or \f[CR]NULL\f[R] on failure.
.PP
\f[B]Example\f[R]:
.IP
.EX
void    *my_thread(void *arg)
{
    \f[I]// ...\f[R]
    \f[B]return\f[R] (0);
}

{
    t_thread    thread = thread_create(my_thread, NULL);

    \f[B]if\f[R] (!thread)
    {
        \f[I]// handle error\f[R]
    }
}
.EE
.PP
   *   *   *   *   *
.SS \f[CR]THREAD_JOIN\f[R]
.IP
.EX
int THREAD_JOIN(T_THREAD, void **);
int thread_join(t_thread, void **);
.EE
.PP
Waits for the specified thread to terminate.
.PP
The second argument is an optional output parameter used to retrieve the
thread\(aqs return value.
.PP
It may be \f[CR]NULL\f[R] if the return value is not needed.
.PP
Returns \f[CR]0\f[R] on success, or a non\-zero value on failure.
.PP
\f[B]Examples\f[R]:
.IP
.EX
void *ret;

thread_join(thread, &ret);
.EE
.IP
.EX
thread_join(thread, NULL);
.EE
