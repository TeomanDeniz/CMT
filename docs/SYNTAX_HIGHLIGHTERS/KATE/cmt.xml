    <contexts>
      <context name="Normal" attribute="Normal Text" lineEndContext="#stay">
        <RegExpr attribute="CMT Section" context="AsmSection" String="\b(?:STATIC_)?SECTION(?:_KNR)?\b"/>
        <keyword attribute="CMT Control" context="#stay" String="cmt_control"/>
        <keyword attribute="CMT Keyword" context="#stay" String="cmt_keyword"/>
        <keyword attribute="CMT Modifier" context="#stay" String="cmt_modifier"/>
        <keyword attribute="CMT Type" context="#stay" String="cmt_type"/>
        <keyword attribute="CMT OOP" context="#stay" String="cmt_oop"/>
        <keyword attribute="CMT Object" context="#stay" String="cmt_object"/>
        <keyword attribute="CMT This" context="#stay" String="cmt_this"/>
        <IncludeRules context="##C" includeAttrib="true"/>
      </context>
      <context name="AsmSection" attribute="Normal Text" lineEndContext="#stay">
        <WordDetect attribute="CMT Section" context="#pop" String="END"/>
        <keyword attribute="CMT Section" context="#stay" String="cmt_section_knr"/>
        <keyword attribute="CMT Type" context="#stay" String="cmt_type"/>
        <keyword attribute="CMT Modifier" context="#stay" String="cmt_modifier"/>
        <RegExpr attribute="CMT Assembly" context="#stay" String="\b[A-Z]+(?:_[A-Z0-9]+)*_?\b"/>
        <IncludeRules context="##C" includeAttrib="true"/>
      </context>
    </contexts>
    <itemDatas>
      <itemData name="Normal Text" defStyleNum="dsNormal"/>
      <itemData name="CMT Control" defStyleNum="dsControlFlow"/>
      <itemData name="CMT Keyword" defStyleNum="dsKeyword"/>
      <itemData name="CMT Modifier" defStyleNum="dsAttribute"/>
