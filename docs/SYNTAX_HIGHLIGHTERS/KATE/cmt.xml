<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE language>
<!-- CMT (C MAXIMUM TENSION) -->
<!-- FOR KATE, KWRITE, KDEVELOP, QT CREATOR AND ANYTHING USING KSyntaxHighlighting.
     INSTALL: COPY INTO ~/.local/share/org.kde.syntax-highlighting/syntax/
     (WINDOWS: %USERPROFILE%\AppData\Local\org.kde.syntax-highlighting\syntax\)
     THEN PICK "C (CMT)" FROM Tools > Highlighting > Sources. -->
<language name="C (CMT)" section="Sources" version="1" kateversion="5.79" extensions="*.c;*.C;*.h;*.H;*.inl;*.INL" priority="6" indenter="cstyle" author="Teoman Deniz" license="Apache-2.0">
