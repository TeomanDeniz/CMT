## CMT (C MAXIMUM TENSION)
## FULL C SYNTAX PLUS CMT (NANO CAN'T EXTEND ANOTHER SYNTAX).
## INSTALL: COPY TO ~/.nano/cmt.nanorc AND ADD THIS LINE TO ~/.nanorc
##          *ABOVE* ANY  include "/usr/share/nano/*.nanorc"  LINE:
##              include "~/.nano/cmt.nanorc"
##          (NANO USES THE FIRST SYNTAX WHOSE FILE PATTERN MATCHES.)

syntax cmt "\.([ch](pp|xx)?|C|H|HPP|inl|INL|cc|hh)$"
magic "^(C|C\+\+) source"
comment "//"

## PLAIN C
color brightred "\<[A-Z_][0-9A-Z_]*\>"
color green "\<(float|double|bool|char|int|short|long|enum|void|auto|const|signed|unsigned|struct|union|typedef|extern|static|volatile|register|inline|restrict|_Bool|_Atomic|_Thread_local|_Noreturn|_Alignas|_Alignof|_Static_assert)\>"
color green "\<((s?size)|ptrdiff|((u_?)?int(_least|_fast)?(8|16|32|64|ptr|max)))_t\>"
color green "\<(class|explicit|friend|mutable|namespace|override|private|protected|public|template|typename|using|virtual|constexpr|nullptr)\>"
color brightyellow "\<(for|if|while|do|else|case|default|switch|try|throw|catch|operator|new|delete|sizeof)\>"
color magenta "\<(goto|continue|break|return)\>"
color brightcyan "^[[:space:]]*#[[:space:]]*(define|elif|else|endif|error|if|ifdef|ifndef|include|line|pragma|undef|warning)\>"
color cyan "__attribute__[[:space:]]*\(\([^)]*\)\)" "__(aligned|asm|builtin|hidden|inline|packed|restrict|section|typeof|weak)__"

## CMT
color brightyellow "\<(TRY|try|CATCH|catch|THROW|throw|CANCEL|cancel|IS_IN_TRY|is_in_try)\>"
color yellow "\<(LOCAL|local|VA_ARGS|va_args|VA_ARG|va_arg|VA_BEGIN|va_begin|VA_END|va_end|VA_DECLARE|va_declare)\>"
color cyan "\<(FASTCALL|fastcall|STDCALL|stdcall|REGPASS|regpass|REGPARM|regparm|IGNORE_VAR|ignore_var|CDECL|cdecl|FAR|far|NOINLINE|noinline|PASCAL|pascal|EXTERN_C_START|extern_c_start|EXTERN_C_END|extern_c_end|PACK|pack|PRAGMA_PACK_PUSH|pragma_pack_push|PRAGMA_PACK_POP|pragma_pack_pop|ALIGN_UP|align_up|ALIGN_VARIABLE|align_variable|ALIGN_STRUCT_PUSH|align_struct_push|ALIGN_STRUCT_POP|align_struct_pop|MAYBE_ARGS|maybe_args|VOLATILE|volatile|INLINE|inline|REGISTER|register|RESTRICT|restrict|UNUSED|FORCE_INLINE)\>"
color green "\<(VAR|var|LET|let|PTR|ptr|FAR_PTR|far_ptr|BOOLEAN|boolean|BYTE|byte|BIT8|bit8|BIT16|bit16|BIT32|bit32|BIT64|bit64|BIT128|bit128|FLOAT32|float32|FLOAT64|float64|FLOAT128|float128|JMP_BUF|jmp_buf|VA_LIST|va_list|CONSOLE|console|KERNEL32|USER32)\>"
color brightmagenta "\<(NEW|new|OBJ|obj|DELETE|delete|DESTROY|destroy|OBJECT__CONNECT|object__connect|OBJECT__INJECT|object__inject|OBJECT__EJECT|object__eject|OBJECT__INITIALIZE|object__initialize|OBJECT__COPY|object__copy|OBJECT__PROTOTYPE_ALLOC|object__prototype_alloc|OBJECT__PROTOTYPE_FREE|object__prototype_free|__DESTRUCTOR__|OBJECT|object)\>"
color brightgreen "\<(THIS|this)\>"
color brightcyan "\<(SECTION|STATIC_SECTION|SECTION_KNR|STATIC_SECTION_KNR|END)\>"

## STRINGS AND COMMENTS LAST, SO THEY WIN
color brightmagenta "'([^'\\]|\\(["'\\abfnrtv]|x[[:xdigit:]]{1,2}|[0-3]?[0-7]{1,2}))'"
color brightyellow ""([^"\\]|\\.)*"" "#[[:space:]]*include[[:space:]]+<[^>]+>"
color brightblue "//.*"
color brightblue start="/\*" end="\*/"
color ,green "[[:space:]]+$"
