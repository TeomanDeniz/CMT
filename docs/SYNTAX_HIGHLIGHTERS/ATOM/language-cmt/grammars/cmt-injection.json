{
  "scopeName": "cmt.injection",
  "injectionSelector": "L:source.c -comment -string -meta.section.asm.cmt, L:source.cpp -comment -string -meta.section.asm.cmt",
  "patterns": [
    {
      "include": "#section"
    },
    {
      "include": "#object-decl"
    },
    {
      "include": "#oop"
    },
    {
      "include": "#this"
    },
    {
      "include": "#types"
    },
    {
      "include": "#modifiers"
    }
  ],
  "repository": {
    "section": {
      "begin": "\\b(STATIC_SECTION_KNR|SECTION_KNR|STATIC_SECTION|SECTION)\\b",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.section.begin.cmt"
        }
      },
      "end": "\\b(END)\\b|(?=^\\s*(?:STATIC_)?SECTION\\b(?!_KNR))",
      "endCaptures": {
        "1": {
          "name": "keyword.control.section.end.cmt"
        }
      },
      "name": "meta.section.asm.cmt",
      "patterns": [
        {
          "match": "\\b(STATIC_SECTION_KNR|SECTION_KNR)\\b",
          "name": "keyword.control.section.begin.cmt"
        },
        {
          "begin": "//",
          "end": "$",
          "name": "comment.line.double-slash.cmt"
        },
        {
          "begin": "/\\*",
          "end": "\\*/",
          "name": "comment.block.cmt"
        },
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.cmt"
        },
        {
          "match": "\\b(asm|__asm__|auto|bool|_Bool|char|_Complex|double|float|int|long|short|signed|unsigned|void|const|static|extern|register|struct|union|enum)\\b",
          "name": "storage.type.cmt"
        },
        {
          "match": "\\b((?i:VAR)|(?i:LET)|(?i:PTR)|(?i:FAR_PTR)|(?i:BOOLEAN)|(?i:BYTE)|(?i:BIT8)|(?i:BIT16)|(?i:BIT32)|(?i:BIT64)|(?i:BIT128)|(?i:FLOAT32)|(?i:FLOAT64)|(?i:FLOAT128)|(?i:JMP_BUF)|(?i:CONSOLE)|KERNEL32|USER32)\\b",
          "name": "support.type.cmt_types.cmt"
        },
        {
          "match": "\\b(REGISTER|RESTRICT)\\b",
          "name": "storage.modifier.cmt"
        },
        {
          "match": "\\b[A-Z]+(?:_[A-Z0-9]+)*_?\\b",
          "name": "variable.language.asm.cmt"
        },
        {
          "match": "\\b(?:0[xX][0-9a-fA-F]+|\\d+)\\b",
          "name": "constant.numeric.cmt"
        }
      ]
    },
    "object-decl": {
      "match": "\\b((?i:OBJECT))\\s+([A-Za-z_]\\w*)",
      "captures": {
        "1": {
          "name": "keyword.declaration.struct.cmt storage.type.struct.cmt"
        },
        "2": {
          "name": "entity.name.type.struct.cmt"
        }
      }
    },
    "oop": {
      "match": "\\b((?i:NEW)|(?i:OBJ)|(?i:DELETE)|(?i:DESTROY)|(?i:OBJECT__CONNECT)|(?i:OBJECT__INJECT)|(?i:OBJECT__EJECT)|(?i:OBJECT__INITIALIZE)|(?i:OBJECT__COPY)|(?i:OBJECT__PROTOTYPE_ALLOC)|(?i:OBJECT__PROTOTYPE_FREE)|__DESTRUCTOR__)\\b",
      "name": "keyword.cmt_oop.cmt keyword.other.cmt"
    },
    "this": {
      "match": "\\b(?i:this)\\b",
      "name": "variable.language.this.cmt"
    },
    "types": {
      "match": "\\b((?i:VAR)|(?i:LET)|(?i:PTR)|(?i:FAR_PTR)|(?i:BOOLEAN)|(?i:BYTE)|(?i:BIT8)|(?i:BIT16)|(?i:BIT32)|(?i:BIT64)|(?i:BIT128)|(?i:FLOAT32)|(?i:FLOAT64)|(?i:FLOAT128)|(?i:JMP_BUF)|(?i:CONSOLE)|KERNEL32|USER32)\\b",
      "name": "support.type.cmt_types.cmt"
    },
    "modifiers": {
      "match": "\\b((?i:FASTCALL)|(?i:STDCALL)|(?i:REGPASS)|(?i:REGPARM)|(?i:IGNORE_VAR)|(?i:CDECL)|(?i:FAR)|(?i:NOINLINE)|(?i:PASCAL)|(?i:EXTERN_C_START)|(?i:EXTERN_C_END)|(?i:PACK)|(?i:PRAGMA_PACK_PUSH)|(?i:PRAGMA_PACK_POP)|(?i:ALIGN_UP)|(?i:ALIGN_VARIABLE)|(?i:ALIGN_STRUCT_PUSH)|(?i:ALIGN_STRUCT_POP)|(?i:MAYBE_ARGS)|(?i:VOLATILE)|(?i:INLINE)|UNUSED|FORCE_INLINE|(?i:TRY)|(?i:CATCH)|(?i:THROW)|(?i:CANCEL)|(?i:IS_IN_TRY)|(?i:LOCAL)|(?i:VA_ARGS)|(?i:VA_ARG)|(?i:VA_BEGIN)|(?i:VA_END)|(?i:VA_DECLARE)|(?i:VA_LIST)|REGISTER|RESTRICT)\\b",
      "name": "storage.modifier.cmt"
    }
  }
}