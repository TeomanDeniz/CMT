#define LOCALMACRO__CMT_CONSOLE__WARNING_AT_CONTENT \
	char	INT_STR[12];\
	\
	{\
		REGISTER int	INDEX_1 = 0;\
		REGISTER int	INDEX_2;\
		REGISTER int	INDEX_3;\
		REGISTER int	INDEX_FOR;\
		\
		INDEX_2 = INDEX_1;\
		\
		do\
		{\
			INT_STR[INDEX_2++] = 48 + (THE_LINE % 10);\
			THE_LINE /= 10;\
		}\
		while (THE_LINE);\
		\
		INT_STR[INDEX_2] = (char)0;\
		INDEX_FOR = INDEX_1;\
		INDEX_3 = INDEX_2 - 1;\
		\
		while (INDEX_FOR < INDEX_3)\
		{\
			const char	CHARACTER = INT_STR[INDEX_FOR];\
			\
			INT_STR[INDEX_FOR] = INT_STR[INDEX_3];\
			INT_STR[INDEX_3] = CHARACTER;\
			++INDEX_FOR;\
			--INDEX_3;\
		}\
	}\
	\
	LOCALMACRO__CMT_CONSOLE__ENTER\
	LOCALMACRO__CMT_CONSOLE__BATCH_BEGIN\
	\
	if (THIS->HIGHLIGHTER)\
	{\
		LOCALMACRO__CMT_CONSOLE__ENTER\
		OBJECT__INITIALIZE (THIS->GET.CURSOR.COLOR, unsigned int) = 0XB;\
		LOCALMACRO__CMT_CONSOLE__SETTLE\
		LOCALMACRO__CMT_CONSOLE__LOG_INLINE("\n ");\
		LOCALMACRO__CMT_CONSOLE__LOG_INLINE(THE_FILE);\
		LOCALMACRO__CMT_CONSOLE__ENTER\
		OBJECT__INITIALIZE (THIS->GET.CURSOR.COLOR, unsigned int) = \
			THIS->GET.CURSOR.DEFAULT_COLOR;\
		LOCALMACRO__CMT_CONSOLE__SETTLE\
		LOCALMACRO__CMT_CONSOLE__LOG_INLINE(" (");\
		LOCALMACRO__CMT_CONSOLE__ENTER\
		OBJECT__INITIALIZE (THIS->GET.CURSOR.COLOR, unsigned int) = 0XB;\
		LOCALMACRO__CMT_CONSOLE__SETTLE\
		LOCALMACRO__CMT_CONSOLE__LOG_INLINE(INT_STR);\
		LOCALMACRO__CMT_CONSOLE__ENTER\
		OBJECT__INITIALIZE (THIS->GET.CURSOR.COLOR, unsigned int) = \
			THIS->GET.CURSOR.DEFAULT_COLOR;\
		LOCALMACRO__CMT_CONSOLE__SETTLE\
		LOCALMACRO__CMT_CONSOLE__LOG_INLINE("): ");\
		LOCALMACRO__CMT_CONSOLE__ENTER\
		OBJECT__INITIALIZE (THIS->GET.CURSOR.COLOR, unsigned int) = 0XD;\
		LOCALMACRO__CMT_CONSOLE__SETTLE\
		LOCALMACRO__CMT_CONSOLE__LOG_INLINE("WARNING");\
		LOCALMACRO__CMT_CONSOLE__ENTER\
		OBJECT__INITIALIZE (THIS->GET.CURSOR.COLOR, unsigned int) = \
			THIS->GET.CURSOR.DEFAULT_COLOR;\
		LOCALMACRO__CMT_CONSOLE__SETTLE\
		LOCALMACRO__CMT_CONSOLE__LOG_INLINE(": ");\
		LOCALMACRO__CMT_CONSOLE__ENTER\
		OBJECT__INITIALIZE (THIS->GET.CURSOR.COLOR, unsigned int) = 0XF;\
		LOCALMACRO__CMT_CONSOLE__SETTLE\
		LOCALMACRO__CMT_CONSOLE__LOG_INLINE(STRING);\
		LOCALMACRO__CMT_CONSOLE__ENTER\
		OBJECT__INITIALIZE (THIS->GET.CURSOR.COLOR, unsigned int) = \
			THIS->GET.CURSOR.DEFAULT_COLOR;\
		LOCALMACRO__CMT_CONSOLE__SETTLE\
	}\
	else\
	{\
		LOCALMACRO__CMT_CONSOLE__LOG_INLINE("\n ");\
		LOCALMACRO__CMT_CONSOLE__LOG_INLINE(THE_FILE);\
		LOCALMACRO__CMT_CONSOLE__LOG_INLINE(":(");\
		LOCALMACRO__CMT_CONSOLE__LOG_INLINE(INT_STR);\
		LOCALMACRO__CMT_CONSOLE__LOG_INLINE("): WARNING: ");\
		LOCALMACRO__CMT_CONSOLE__LOG_INLINE(STRING);\
	}\
	\
	LOCALMACRO__CMT_CONSOLE__BATCH_END

